<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.hospital</groupId>
    <artifactId>hospital-admin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>hospital-admin</name>
    <description>医疗后台管理系统</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <springdoc.version>3.1.1</springdoc.version>
        <lombok.version>1.18.48</lombok.version>
        <easyexcel.version>4.0.3</easyexcel.version>
        <openpdf.version>2.0.3</openpdf.version>
    </properties>

    <dependencies>
        <!-- Web MVC：Boot 4 模块化后的细粒度 starter；经典 spring-boot-starter-web 亦可用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 参数校验（Jakarta Validation） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP：审计日志切面、数据权限切面。
             ⚠️ Boot 4 把 spring-boot-starter-aop 改名为 spring-boot-starter-aspectj，
                沿用旧坐标会报 "version is missing"（BOM 不再管理它） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- 安全：Spring Security 7 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 缓存：登录态与登录失败计数（多实例共享）。
             Boot 4 仍沿用 spring-boot-starter-data-redis 坐标；底层默认 Lettuce。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 持久层：Boot 4 必须用 boot4 starter，用 boot3 starter 会启动报 factoryBeanObjectType 错误 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 分页插件 PaginationInnerInterceptor 依赖 JSqlParser，需单独引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 接口文档：仅 3.x 适配 Boot 4 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- 报表导出：EasyExcel 写 xlsx（流式写，百万行也不会 OOM）。
             ⚠️ 不能和 poi-ooxml 混用版本：EasyExcel 4.x 内部依赖 POI 5.x，
                项目里不再单独声明 poi，交给 EasyExcel 传递依赖，避免 NoSuchMethodError。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>${easyexcel.version}</version>
        </dependency>

        <!-- 报表导出 PDF：OpenPDF（iText 4 的 LGPL 分支）。
             选它而不是 iText 5/7 是因为后者是 AGPL/商业双授权，
             医院这类交付型项目一旦用了，要么开源要么付license。 -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      JDK 23 起注解处理默认关闭（-proc:none 行为），Lombok 不显式声明
                      annotationProcessorPaths 会「编译通过但 getter/setter 全部不存在」，
                      后续报错信息极难定位，属于典型返工坑。
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!-- 保留方法参数名，Spring MVC 绑定与 MyBatis 映射都需要 -->
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      JDK 25 起，Mockito 的 inline-mock-maker 靠「运行时自我挂载 agent」工作，
                      会打印 "Mockito is currently self-attaching..." 警告，且后续 JDK 将禁止该行为。
                      显式以 -javaagent 方式加载，既消除警告也避免将来升级 JDK 时测试集体失效。
                    -->
                    <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
