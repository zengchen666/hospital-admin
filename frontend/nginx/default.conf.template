# Nginx 站点配置（模板）
#
# 文件名必须是 *.template 并放在 /etc/nginx/templates/：
# nginx 官方镜像启动时用 envsubst 渲染到 /etc/nginx/conf.d/default.conf，
# 只替换 ${BACKEND_UPSTREAM} 这类「已定义的环境变量」，
# $uri / $host 等 nginx 变量保持原样。
#
# 为什么用反代而不是让前端直连后端端口：
#   同源之后没有跨域，生产 profile 的 cors.allowed-origins 可以直接留空。

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # 与后端 spring.servlet.multipart.max-request-size=50MB 对齐，
    # 不然大附件会卡在 Nginx 这一层返回 413，后端日志里什么都看不到。
    client_max_body_size 50m;

    gzip               on;
    gzip_comp_level    5;
    gzip_min_length    1k;
    gzip_vary          on;
    gzip_types         text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml image/svg+xml;

    # 容器探针专用：不落 access_log，免得健康检查把日志刷满
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite 产物带内容 hash，可以放心长缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 后端 API。
    # ⚠️ 后端 context-path 就是 /api，这里原样转发、绝对不要 rewrite 掉前缀 ——
    #    本地 Vite 代理能跑、上了 Nginx 就 404，八成是这里多写了 rewrite。
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout    120s;
        # 报表导出要现算 Excel/PDF，十几秒是常态，读超时给足
        proxy_read_timeout    120s;
        # 导出是流式大文件，开着缓冲会让 worker 内存顶上去
        proxy_buffering      off;
    }

    # SPA 回退：项目用 hash 路由，这一条主要兜直接访问子路径与刷新
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 隐藏文件一律不放行（.env、.git 之类）
    location ~ /\. {
        deny  all;
        access_log    off;
        log_notfound  off;
    }
}
