# ============================================================================
# Compose 环境变量样例
#   使用：cp .env.example .env ，然后按注释改掉占位值
#
# ⚠️ .env 已在 .gitignore 中忽略，真实密钥不要进仓库。
# ============================================================================

# ------------------------------- 数据库 -------------------------------
DB_NAME=hospital
# 应用连接用的账号（Compose 会自动在 MySQL 里建这个用户并授权 hospital 库）；
# 不要用 root 跑业务，权限收在库级别。
DB_USERNAME=hospital
DB_PASSWORD=Hospital@123
# 仅用于 MySQL 容器初始化与 healthcheck
MYSQL_ROOT_PASSWORD=Root@123456

# ------------------------------- Redis -------------------------------
# 留空即不启用密码（Redis 只在 compose 内网可达，不映射公网）。
# 一旦要暴露到外部网络，必须设置密码并改 redis 服务的 command 加 --requirepass。
REDIS_PASSWORD=

# ------------------------------ 后端密钥 ------------------------------
# 生产环境务必重新生成，禁止沿用下面的样例值：
#   JWT : openssl rand -base64 48
#   AES : openssl rand -base64 32      （必须是 32 字节的 Base64，否则启动报密钥长度错）
#
# ⚠️ HOSPITAL_AES_KEY 一换，库里已加密的身份证/手机号就解不开了。
#    若要导入已有数据库，必须沿用那套库当初使用的密钥。
JWT_SECRET=pO7jGFmvuRjiy9sEVl1v1WzO3NyWV9RUYYnJFKSLm2752u3hS0iGojxJ8OB7BFiA
HOSPITAL_AES_KEY=tcIz5PiQJFvI36AWWTYve03oaC1HGgscPknrgeOMQ/o=

# --------------------------- 前端反代目标 ---------------------------
# Compose 里就是后端服务名:端口；K8s 部署时改成对应 Service。
BACKEND_UPSTREAM=app:8080
